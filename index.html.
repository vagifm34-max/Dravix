<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root {
  --bg:#05060a;
  --panel:#0b0f19;
  --panel2:#101626;
  --blue:#5488ff;
  --cyan:#67d7ff;
  --text:#f6f8ff;
  --muted:#929db3;
  --border:rgba(255,255,255,.09);
  --glow:rgba(57,112,255,.2);
}

* { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; scroll-padding-top:90px; }

body {
  font-family:Inter,Arial,sans-serif;
  background:
    radial-gradient(ellipse at 50% -15%,#152957 0%,transparent 48%),
    radial-gradient(ellipse at 100% 45%,#10152b 0%,transparent 36%),
    var(--bg);
  color:var(--text);
  min-height:100vh;
  overflow-x:hidden;
}

body:before {
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:-1;
  opacity:.22;
  background-image:
    linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
  background-size:42px 42px;
  mask-image:linear-gradient(to bottom,#000,transparent 85%);
}

a { color:inherit; text-decoration:none; }
button,input { font:inherit; }
.wrap { width:min(1160px,calc(100% - 36px)); margin:auto; }

header {
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(5,6,10,.8);
  border-bottom:1px solid var(--border);
  backdrop-filter:blur(22px);
}

.nav {
  min-height:72px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.brand {
  display:flex;
  align-items:center;
  gap:12px;
  font-weight:900;
  font-size:22px;
  letter-spacing:-.8px;
}

.brand-icon {
  width:42px;
  height:42px;
  display:grid;
  place-items:center;
  border:1px solid rgba(110,155,255,.5);
  border-radius:14px;
  background:linear-gradient(145deg,#1b2c52,#0a1020);
  box-shadow:0 0 30px rgba(70,120,255,.2);
  overflow:hidden;
}

.brand-icon img { width:100%; height:100%; object-fit:cover; }
.brand-icon .fallback { font-size:23px; color:#79a5ff; }

.nav-links { display:flex; align-items:center; gap:18px; }
.nav-links a { font-size:12px; color:#a8b1c3; transition:.2s; }
.nav-links a:hover { color:#fff; }

.nav-cta {
  padding:11px 16px;
  border:1px solid rgba(100,145,255,.4);
  border-radius:11px;
  background:rgba(70,115,255,.12);
  color:white!important;
}

.hero { padding:100px 0 75px; text-align:center; }

.pill {
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:9px 14px;
  border:1px solid rgba(116,155,255,.24);
  border-radius:999px;
  background:rgba(55,100,220,.09);
  color:#c4d4ff;
  font-size:11px;
  letter-spacing:.5px;
}

.pulse {
  width:7px;
  height:7px;
  border-radius:50%;
  background:#5bffbd;
  box-shadow:0 0 14px #5bffbd;
}

.hero h1 {
  margin:28px auto 0;
  font-size:clamp(49px,8vw,91px);
  line-height:.99;
  letter-spacing:-5px;
  font-weight:900;
}

.gradient {
  color:#7ba4ff;
  background:linear-gradient(90deg,#7b9dff,#54d7ff,#a4b8ff);
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
}

.hero p {
  max-width:650px;
  margin:24px auto 0;
  color:var(--muted);
  font-size:15px;
  line-height:1.9;
}

.actions {
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:12px;
  margin-top:30px;
}

.btn {
  min-height:46px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:0 19px;
  border:1px solid var(--border);
  border-radius:12px;
  background:#101522;
  color:#fff;
  font-size:12px;
  font-weight:700;
  cursor:pointer;
  transition:transform .2s,border-color .2s,box-shadow .2s;
}

.btn:hover {
  transform:translateY(-3px);
  border-color:rgba(125,165,255,.55);
}

.btn-primary {
  border-color:#628dff;
  background:linear-gradient(135deg,#6794ff,#3566e9);
  box-shadow:0 8px 30px rgba(55,105,255,.22);
}

.btn-primary:hover { box-shadow:0 12px 38px rgba(55,105,255,.38); }

.showcase {
  position:relative;
  max-width:860px;
  margin:65px auto 0;
  padding:1px;
  border-radius:24px;
  background:linear-gradient(135deg,rgba(112,160,255,.65),rgba(255,255,255,.04),rgba(68,115,255,.3));
  box-shadow:0 30px 100px rgba(0,0,0,.45);
}

.showcase-inner {
  padding:35px 25px 40px;
  border-radius:23px;
  background:
    radial-gradient(ellipse at 50% 0%,rgba(60,110,255,.23),transparent 65%),
    #090d17;
}

.big-windows {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:5px;
  width:76px;
  height:76px;
  margin:0 auto 24px;
  transform:perspective(150px) rotateY(-8deg);
}

.big-windows i {
  background:linear-gradient(140deg,#8bb7ff,#3670ff);
  box-shadow:0 0 22px rgba(65,125,255,.24);
}

.showcase h2 { font-size:30px; letter-spacing:-1px; }
.showcase p { margin-top:9px; color:var(--muted); font-size:12px; }

.stats {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  max-width:720px;
  margin:28px auto 0;
}

.stat {
  padding:17px 10px;
  border:1px solid var(--border);
  border-radius:14px;
  background:rgba(255,255,255,.025);
}

.stat strong { display:block; font-size:20px; }
.stat span { display:block; margin-top:5px; color:var(--muted); font-size:10px; }

.section { padding:78px 0; }
.section-top { margin-bottom:29px; }

.eyebrow {
  margin-bottom:11px;
  color:#7ea3ff;
  font-size:10px;
  font-weight:800;
  letter-spacing:2px;
  text-transform:uppercase;
}

.section h2 {
  font-size:clamp(31px,5vw,47px);
  letter-spacing:-2px;
  line-height:1.1;
}

.description {
  max-width:680px;
  margin-top:13px;
  color:var(--muted);
  font-size:13px;
  line-height:1.85;
}

.glass {
  border:1px solid var(--border);
  border-radius:20px;
  background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.012)),var(--panel);
  box-shadow:0 20px 60px rgba(0,0,0,.17);
}

.creator-grid {
  display:grid;
  grid-template-columns:.8fr 1.5fr;
  gap:16px;
}

.creator-card,.about-card { padding:30px; }

.avatar {
  width:65px;
  height:65px;
  display:grid;
  place-items:center;
  overflow:hidden;
  border-radius:19px;
  border:1px solid rgba(125,165,255,.35);
  background:linear-gradient(135deg,#1c3d86,#101629);
  box-shadow:0 0 35px rgba(65,110,255,.2);
  font-weight:900;
  font-size:20px;
}

.avatar img { width:100%; height:100%; object-fit:cover; }
.creator-card h3 { margin-top:23px; font-size:24px; }
.creator-card p,.about-card p { margin-top:10px; color:var(--muted); font-size:12px; line-height:1.9; }
.creator-card .btn { margin-top:24px; }
.about-card h3 { font-size:21px; }

.feature-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-top:23px;
}

.feature {
  padding:14px;
  border:1px solid var(--border);
  border-radius:12px;
  background:rgba(255,255,255,.02);
}

.feature strong { display:block; font-size:12px; }
.feature span { display:block; margin-top:6px; color:var(--muted); font-size:10px; }

.project-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
}

.project {
  position:relative;
  overflow:hidden;
  padding:28px;
  transition:transform .25s,border-color .25s,box-shadow .25s;
}

.project:hover {
  transform:translateY(-4px);
  border-color:rgba(105,150,255,.4);
  box-shadow:0 22px 55px rgba(0,0,0,.3);
}

.project:before {
  content:"";
  position:absolute;
  width:190px;
  height:190px;
  right:-95px;
  top:-100px;
  border-radius:50%;
  background:rgba(65,115,255,.15);
  filter:blur(35px);
  pointer-events:none;
}

.project-no { color:#6e9bff; font-size:10px; font-weight:800; letter-spacing:1.5px; }
.project h3 { position:relative; margin-top:22px; font-size:25px; }
.project p { position:relative; margin-top:11px; color:var(--muted); font-size:12px; line-height:1.9; }

.status {
  display:inline-flex;
  margin-top:22px;
  padding:8px 11px;
  border:1px solid rgba(255,190,95,.2);
  border-radius:8px;
  background:rgba(255,190,95,.06);
  color:#ffd08a;
  font-size:9px;
  font-weight:800;
  letter-spacing:.6px;
}

.status-ready {
  border-color:rgba(91,255,189,.22);
  background:rgba(91,255,189,.06);
  color:#80ffcb;
}

.notice {
  margin-top:20px;
  padding:22px;
  border:1px solid rgba(83,135,255,.25);
  border-radius:16px;
  background:linear-gradient(120deg,rgba(58,103,230,.12),rgba(255,255,255,.015));
}

.notice strong { font-size:13px; }
.notice p { margin-top:9px; color:var(--muted); font-size:12px; line-height:1.8; }

.search { margin-bottom:22px; }

.search input {
  width:100%;
  height:55px;
  padding:0 18px;
  outline:none;
  border:1px solid var(--border);
  border-radius:14px;
  background:#090d16;
  color:white;
}

.search input:focus {
  border-color:#527fff;
  box-shadow:0 0 0 4px rgba(65,110,255,.1);
}

.search input::placeholder { color:#707b90; }

.windows-grid {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:14px;
}

.windows-card {
  display:flex;
  flex-direction:column;
  min-width:0;
  padding:23px;
  transition:transform .22s,border-color .22s,box-shadow .22s;
}

.windows-card:hover {
  transform:translateY(-4px);
  border-color:rgba(107,153,255,.4);
  box-shadow:0 22px 55px rgba(0,0,0,.3);
}

.windows-logo {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:3px;
  width:37px;
  height:37px;
  margin-bottom:19px;
}

.windows-logo i { background:linear-gradient(135deg,#8bb6ff,#3b72f6); }

.version {
  color:#7da1ff;
  font-size:9px;
  font-weight:800;
  letter-spacing:1.5px;
  text-transform:uppercase;
}

.windows-card h3 { margin-top:7px; font-size:25px; letter-spacing:-.7px; }
.windows-card p { margin-top:8px; color:var(--muted); font-size:11px; line-height:1.7; }
.tags { display:flex; flex-wrap:wrap; gap:6px; margin-top:15px; }

.tag {
  padding:6px 8px;
  border:1px solid var(--border);
  border-radius:7px;
  background:rgba(255,255,255,.025);
  color:#aeb9ce;
  font-size:9px;
}

.download { margin-top:auto; padding-top:22px; }
.download .btn { width:100%; min-height:41px; font-size:11px; }
.hidden { display:none!important; }

.help-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
.help-card { padding:23px; }
.help-card .num { color:#7ea3ff; font-size:11px; font-weight:800; }
.help-card h3 { margin-top:15px; font-size:16px; }
.help-card p { margin-top:9px; color:var(--muted); font-size:11px; line-height:1.8; }

.contact {
  padding:55px 25px;
  text-align:center;
  background:radial-gradient(ellipse at 50% 0%,rgba(60,105,255,.2),transparent 65%),var(--panel);
}

.contact .description { margin-left:auto; margin-right:auto; }
.contact .actions { margin-top:24px; }
footer { margin-top:25px; border-top:1px solid var(--border); }

.footer-inner {
  min-height:100px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.footer-brand { font-size:13px; font-weight:800; }
.footer-inner p { margin-top:7px; color:#758096; font-size:10px; }
.footer-copy { color:#758096; font-size:10px; }

@media(max-width:1000px) {
  .nav-links { gap:11px; }
  .nav-links a { font-size:10px; }
}

@media(max-width:900px) {
  .windows-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .creator-grid { grid-template-columns:1fr; }
}

@media(max-width:650px) {
  .wrap { width:calc(100% - 28px); }
  .nav { min-height:64px; }
  .nav-links { display:none; }
  .hero { padding:70px 0 45px; }
  .hero h1 { letter-spacing:-3px; }
  .hero p { font-size:13px; }
  .showcase { margin-top:42px; }
  .showcase-inner { padding:29px 15px 32px; }
  .section { padding:58px 0; }
  .windows-grid,.project-grid,.help-grid { grid-template-columns:1fr; }
  .stats { gap:7px; }
  .stat strong { font-size:17px; }
  .stat span { font-size:9px; }
  .creator-card,.about-card,.project { padding:23px; }
  .footer-inner { padding:23px 0; flex-direction:column; align-items:flex-start; justify-content:center; }
}
</style>
</head>

